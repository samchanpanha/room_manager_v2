# ──────────────────────────────────────────────────────────────────────────────
# RentManager — Docker ignore
# ──────────────────────────────────────────────────────────────────────────────

# Dependencies (reinstalled in container)
node_modules

# Build output (rebuilt in container)
.next

# Git
.git
.gitignore

# IDE / Editor
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Documentation (not needed in image — except the admin-guide sources, which
# the builder compiles into public/admin-guide/ during the image build)
docs/
!docs/admin-guide/
!docs/admin-guide/**
*.md
!README.md
!docs/admin-guide/**/*.md

# Tests
tests/
vitest.config.ts
__snapshots__/

# SQLite-era databases (Postgres is the datasource — seed creates fresh data)
prisma/dev.db
prisma/test-billing.db
test-billing.db

# Storage objects (mounted as volume)
storage/objects/

# Backups (mounted as volume)
backups/

# Environment files (passed via docker-compose)
.env
.env.*

# CI/CD
.github/

# Scripts not needed at runtime
scripts/
p22_ids.mts

# TypeScript build info
tsconfig.tsbuildinfo
